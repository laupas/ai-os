# Copy to .env next to the compose file and uncomment `env_file: .env` there.
# Never commit .env. Claude, Slack, Teams and the rest can be set in the console
# instead.

# Claude: an API key (recommended on a server), or a Claude Code OAuth token from
# `claude setup-token`. One of the two.
ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=

# Required. Encrypts the secret variables, connector sign-ins, SSH keys and tokens
# ai-os stores, and is kept here, never in the data dir. Any long random value:
#   openssl rand -base64 48
# Save it in your password manager: without it the stored secrets cannot be read.
# Replace it under Settings → Security: the new key here, the old one in
# AIOS_SECRETS_KEY_PREVIOUS until ai-os has moved every secret onto the new one.
AIOS_SECRETS_KEY=
#AIOS_SECRETS_KEY_PREVIOUS=

# Slack (channel), optional.
#SLACK_BOT_TOKEN=xoxb-...
#SLACK_APP_TOKEN=xapp-...

# Microsoft Teams (channel, Socket Mode), optional: a bot from the Teams Developer Portal.
#TEAMS_APP_ID=
#TEAMS_APP_PASSWORD=
#TEAMS_TENANT_ID=

# Signal (sender), optional: a signal-cli-rest-api container and your number.
#SIGNAL_API_URL=http://signal-api:8080
#SIGNAL_SENDER=+15551234567

# Mail through Resend (sender), optional.
#RESEND_API_KEY=re_...
#AIOS_MAIL_FROM=ai-os <ai-os@example.com>

# Voice notes are transcribed with OpenAI Whisper, optional.
#OPENAI_API_KEY=


# Moving to a new machine: with an empty data dir, clone the configuration from here.
#AIOS_CONFIG_REMOTE=git@github.com:you/ai-os-config.git
#AIOS_CONFIG_SSH_KEY=
#AIOS_CONFIG_TOKEN=

# A one-shot deployment (a cloud template) without a config.yaml in the data dir:
# the first config.yaml as YAML or JSON, written only into an empty data dir, and
# the owner's first console password for web.auth.mode: password, set only while
# nobody has one.
#AIOS_INITIAL_CONFIG=
#AIOS_OWNER_PASSWORD=
