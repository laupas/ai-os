# Copy to .env next to docker-compose.example.yml. Never commit .env.

# Claude: an API key (recommended on a server), or a Claude Code OAuth token from
# `claude setup-token`. One of the two.
ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=

# Required: encrypts the secret variables, SSH keys and tokens set in the console.
# Any long random value, e.g. `openssl rand -base64 48`. Changing it later makes
# every stored secret unreadable.
AIOS_SECRETS_KEY=

# Slack (channel), optional.
#SLACK_BOT_TOKEN=xoxb-...
#SLACK_APP_TOKEN=xapp-...

# Signal (sender), optional: a signal-cli-rest-api container and your number.
#SIGNAL_API_URL=http://signal-api:8080
#SIGNAL_SENDER=+15551234567

# Mail through Resend (sender), optional.
#RESEND_API_KEY=re_...
#AIOS_MAIL_FROM=ai-os <ai-os@example.com>

# Voice notes are transcribed with OpenAI Whisper, optional.
#OPENAI_API_KEY=


# Moving to a new machine: with an empty data dir, clone the configuration from here.
#AIOS_CONFIG_REMOTE=git@github.com:you/ai-os-config.git
#AIOS_CONFIG_SSH_KEY=
#AIOS_CONFIG_TOKEN=
